# ============================================================
#  Variables de entorno del backend
# ============================================================
#
#  Copiar a `.env` para desarrollo:  cp .env.example .env
#  En produccion NO se copia: cada variable se carga en el panel del
#  proveedor (Railway). `.env` esta en `.gitignore` y no se commitea.
#
#  `src/config/env.ts` valida TODO esto al arrancar con Zod y **se niega a
#  arrancar** si falta una. No hay defaults para lo sensible a proposito:
#  es preferible un deploy que falla de entrada a uno que queda andando con
#  la configuracion de desarrollo.
#
#  ┌─────────────────┬──────────┬─────────────────────────────────────────┐
#  │ VARIABLE        │ SECRETA  │ NOTA                                     │
#  ├─────────────────┼──────────┼─────────────────────────────────────────┤
#  │ DATABASE_URL    │   SI     │ Railway la inyecta. No escribir a mano    │
#  │ JWT_SECRET      │   SI     │ Unico por ambiente, >=32 chars           │
#  │ STORAGE_ACCESS_KEY  │ SI  │ Credencial de R2                         │
#  │ STORAGE_SECRET_KEY  │ SI  │ Credencial de R2                         │
#  └─────────────────┴──────────┴─────────────────────────────────────────┘

# ---- Entorno ----
# development | test | production
NODE_ENV=development

# Puerto y host. En Railway NO se fijan: la plataforma inyecta PORT y el
# servidor tiene que tomarlo (por eso `env.ts` lo lee del entorno).
PORT=3000
HOST=0.0.0.0

# ---- Base de datos ----
# En Windows usar 127.0.0.1, NO localhost: `localhost` resuelve a ::1 (IPv6)
# y el motor de Prisma no conecta por ahi aunque el puerto este publicado.
DATABASE_URL=postgresql://vinoteca:vinoteca@127.0.0.1:5432/vinoteca

# ---- Auth ----
# SECRETA. En produccion: cadena aleatoria de 32 caracteres o mas.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Si se reusa la de desarrollo, los tokens de cualquiera valen en produccion.
JWT_SECRET=dev-secret-de-al-menos-32-caracteres-xxxx

# Duracion del access token y del refresh (dias).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# ---- CORS ----
# Origen permitido. En produccion: el dominio de Vercel.
# NO admite comodin: con `credentials: 'include'` el comodin es invalido por
# spec, y abriria el panel a cualquier sitio.
# Los previews de Vercel NO se agregan: salen de una rama cualquiera y no son
# un origen confiable (CE-07 de la spec).
CORS_ORIGIN=http://localhost:5173

# ---- Rate limit ----
# Global y del login. LOGIN_RATE_MAX es el que frena el adivinado de claves.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
LOGIN_RATE_MAX=5

# ---- Upload ----
# Tope por archivo, en bytes (5 MB).
UPLOAD_MAX_BYTES=5242880

# ---- Storage (S3-compatible: Cloudflare R2, AWS S3, MinIO) ----
# Endpoint de la API S3. NO es la URL que se abre en el navegador.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=wine-images

# SECRETAS. Credenciales del bucket.
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# URL publica del bucket. ES DISTINTA de STORAGE_ENDPOINT.
#
# Es la que se guarda como `imageUrl` del vino, asi que tiene que ser ESTABLE:
# sin firma y sin expiracion. Antes se guardaba una URL firmada de 1 hora y la
# imagen se rompia al dia siguiente.
#
#   Cloudflare R2 (dev):  https://pub-<cuenta>.r2.dev
#   Cloudflare R2 (prod): https://img.tudominio.com    (con dominio propio)
#   MinIO local:          http://localhost:9000/wine-images
#
# El bucket tiene que permitir lectura publica para que el <img> del navegador
# la pueda cargar (ver CE-04 de la spec 005).
STORAGE_PUBLIC_URL=http://localhost:9000/wine-images

# ---- API ----
# URL publica del backend. Se usa como `servers[0]` del OpenAPI.
PUBLIC_API_URL=http://localhost:3000