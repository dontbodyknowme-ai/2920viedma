# Entorno
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Base de datos
# En Windows usar 127.0.0.1, NO localhost: `localhost` resuelve a ::1 (IPv6) y
# el motor de Prisma no conecta por ahi aunque el puerto este publicado.
DATABASE_URL=postgresql://vinoteca:vinoteca@127.0.0.1:5432/vinoteca

# Auth
JWT_SECRET=dev-secret-de-al-menos-32-caracteres-xxxx
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# CORS (frontend dev)
CORS_ORIGIN=http://localhost:5173

# Rate limit
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
LOGIN_RATE_MAX=5

# Upload
UPLOAD_MAX_BYTES=5242880

# Storage (S3-compatible: AWS, R2, MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=wine-images
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Public API URL (para signed URLs)
PUBLIC_API_URL=http://localhost:3000