generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // `url` es la **pooled**: la usa la aplicacion. Neon y cualquier proveedor
  // con pooler cortan conexiones o limitan cuantas se pueden abrir, y Prisma
  // con su propio pool encima las agota.
  url = env("DATABASE_URL")

  // `directUrl` es la **sin pooler**, y solo la usa `prisma migrate deploy`.
  //
  // No es una diferencia de rendimiento: es que el pooler de Neon es PgBouncer
  // en modo *transaction*, que devuelve la conexion real al pool al terminar
  // cada transaccion. `migrate deploy` toma un **advisory lock de sesion** con
  // `pg_advisory_lock`, asi que:
  //
  //   1. el lock se toma en una conexion backend del PgBouncer
  //   2. la transaccion termina, PgBouncer devuelve esa conexion al pool
  //   3. el lock **se queda puesto** en esa conexion, que queda `idle`
  //   4. el siguiente `migrate deploy` no lo puede tomar y revienta:
  //
  //      Timed out trying to acquire a postgres advisory lock
  //      (SELECT pg_advisory_lock(72707369)). Elapsed: 10000ms.
  //
  // Como el deploy corre `migrate deploy` en el arranque, el segundo deploy ya
  // moria. Y el error era invisible en el panel: Render solo decia
  // "Exited with status 1" sin el motivo.
  directUrl = env("DIRECT_URL")
}

enum WineCategory {
  Tinto
  Blanco
  Rosado
  Espumante
}

enum OrderStatus {
  pendiente
  preparando
  enviado
  entregado
  cancelado
  devuelto
}

enum UserRole {
  admin
  gestor
  vendedor
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         UserRole       @default(vendedor)
  refreshTokens RefreshToken[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Wine {
  id           String       @id @default(cuid())
  name         String
  winery       String
  varietal     String
  category     WineCategory
  vintage      Int
  /// Pesos argentinos enteros. NO centavos (D-15).
  price        Int
  description  String?
  tastingNotes String?
  foodPairing  String?
  imageUrl     String
  stock        Int          @default(0)
  activo       Boolean      @default(true)
  orderItems   OrderItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([category])
  @@index([varietal])
  @@index([activo])
  @@index([name])
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  /// Opcional: CE-04 de 004-a permite clientes sin email.
  /// Postgres permite multiples NULL en una columna UNIQUE.
  email       String?  @unique
  phone       String?
  totalOrders Int      @default(0)
  totalSpent  Int      @default(0)
  lastOrderAt DateTime?
  tags        String[] @default([])
  notes       Note[]
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Note {
  id         String   @id @default(cuid())
  text       String
  /// "Admin" hardcoded: no hay auth real todavia (D-05 de 004-a).
  author     String   @default("Admin")
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model Order {
  id              String          @id @default(cuid())
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  total           Int
  status          OrderStatus     @default(pendiente)
  shippingAddress Json
  timeline        OrderTimeline[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  wineId   String
  wine     Wine   @relation(fields: [wineId], references: [id])
  quantity Int
  /// Precio unitario en el momento de la compra (pesos).
  price    Int

  @@index([orderId])
  @@index([wineId])
}

model OrderTimeline {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  author    String      @default("Admin")
  createdAt DateTime    @default(now())

  @@index([orderId])
}