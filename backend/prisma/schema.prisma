generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WineCategory {
  Tinto
  Blanco
  Rosado
  Espumante
}

enum OrderStatus {
  pendiente
  preparando
  enviado
  entregado
  cancelado
  devuelto
}

enum UserRole {
  admin
  gestor
  vendedor
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         UserRole       @default(vendedor)
  refreshTokens RefreshToken[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Wine {
  id           String       @id @default(cuid())
  name         String
  winery       String
  varietal     String
  category     WineCategory
  vintage      Int
  /// Pesos argentinos enteros. NO centavos (D-15).
  price        Int
  description  String?
  tastingNotes String?
  foodPairing  String?
  imageUrl     String
  stock        Int          @default(0)
  activo       Boolean      @default(true)
  orderItems   OrderItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([category])
  @@index([varietal])
  @@index([activo])
  @@index([name])
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  /// Opcional: CE-04 de 004-a permite clientes sin email.
  /// Postgres permite multiples NULL en una columna UNIQUE.
  email       String?  @unique
  phone       String?
  totalOrders Int      @default(0)
  totalSpent  Int      @default(0)
  lastOrderAt DateTime?
  tags        String[] @default([])
  notes       Note[]
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Note {
  id         String   @id @default(cuid())
  text       String
  /// "Admin" hardcoded: no hay auth real todavia (D-05 de 004-a).
  author     String   @default("Admin")
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model Order {
  id              String          @id @default(cuid())
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  total           Int
  status          OrderStatus     @default(pendiente)
  shippingAddress Json
  timeline        OrderTimeline[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  wineId   String
  wine     Wine   @relation(fields: [wineId], references: [id])
  quantity Int
  /// Precio unitario en el momento de la compra (pesos).
  price    Int

  @@index([orderId])
  @@index([wineId])
}

model OrderTimeline {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  author    String      @default("Admin")
  createdAt DateTime    @default(now())

  @@index([orderId])
}