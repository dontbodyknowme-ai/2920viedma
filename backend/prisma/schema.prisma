generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // `url` es la **pooled**: la usa la aplicacion. Neon y cualquier proveedor
  // con pooler cortan conexiones o limitan cuantas se pueden abrir, y Prisma
  // con su propio pool encima las agota.
  url = env("DATABASE_URL")

  // `directUrl` es la **sin pooler**, y solo la usa `prisma migrate deploy`.
  //
  // No es una diferencia de rendimiento: es que el pooler de Neon es PgBouncer
  // en modo *transaction*, que devuelve la conexion real al pool al terminar
  // cada transaccion. `migrate deploy` toma un **advisory lock de sesion** con
  // `pg_advisory_lock`, asi que:
  //
  //   1. el lock se toma en una conexion backend del PgBouncer
  //   2. la transaccion termina, PgBouncer devuelve esa conexion al pool
  //   3. el lock **se queda puesto** en esa conexion, que queda `idle`
  //   4. el siguiente `migrate deploy` no lo puede tomar y revienta:
  //
  //      Timed out trying to acquire a postgres advisory lock
  //      (SELECT pg_advisory_lock(72707369)). Elapsed: 10000ms.
  //
  // Como el deploy corre `migrate deploy` en el arranque, el segundo deploy ya
  // moria. Y el error era invisible en el panel: Render solo decia
  // "Exited with status 1" sin el motivo.
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  pendiente
  preparando
  enviado
  entregado
  cancelado
  devuelto
}

enum UserRole {
  admin
  gestor
  vendedor
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         UserRole       @default(vendedor)
  refreshTokens RefreshToken[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Wine {
  id           String       @id @default(cuid())
  name         String
  /// Texto libre, no enum. Antes era `WineCategory` (Tinto/Blanco/Rosado/
  /// Espumante) y `prisma migrate dev` no era una opcion para agregar una:
  /// ampliar un enum de Postgres es una migracion, y el admin no puede correr
  /// migraciones desde el panel. Con un `String`, la categoria se crea cargando
  /// un producto que la use, y el filtro del catalogo la deriva de ahi.
  ///
  /// **Ahora es la hoja de la taxonomia, no el tipo de vino**: Vinos, Cerveza,
  /// Gaseosas, Jugos. El color del vino vive en `tipoVino`.
  category     String
  /// Departamento de la tienda: es el eje con el que el panel separa el stock
  /// (pestañas "Stock de bebidas", "Stock de regaleria", etc.).
  ///
  /// **Es un eje distinto de `category`, no lo reemplaza.** `category` es la
  /// hoja (Vinos, Cerveza), `departamento` el grupo de la tienda (Bebidas,
  /// Regaleria) y `grupo` el intermedio. Un Malbec es Bebidas / Con alcohol /
  /// Vinos / Tinto a la vez.
  ///
  /// Texto libre, no enum, por la misma razon que `category`: ampliar un enum
  /// de Postgres es una migracion y el admin no puede correr migraciones desde
  /// el panel.
  ///
  /// El default es 'Bebidas' porque casi todo lo que hay en una tienda es
  /// bebida. Sin default, la migracion tendria que decidir un valor para cada
  /// fila existente y no hay forma de que elija bien.
  departamento String       @default("Bebidas")
  /// Nivel medio de la taxonomia: "Con alcohol", "Sin alcohol", "Energizantes".
  ///
  /// **Nullable a proposito.** "Energizantes" cuelga directo de Bebidas porque
  /// no es ni con alcohol ni sin alcohol; si `grupo` fuera obligatorio, ese
  /// producto tendria que mentir con el grupo o quedarse sin departamento.
  grupo        String?
  /// Color del vino. **Solo se llena en productos de la categoria "Vinos".**
  ///
  /// Es un campo aparte y no una categoria mas porque "Tinto" y "Blanco" cuelgan
  /// de "Vinos": son un atributo de esa categoria, no una categoria hermana. Y
  /// por lo mismo no es texto libre —el admin elige de una lista— para que dos
  /// Malbec no puedan quedar con colores distintos sin que nadie lo note.
  tipoVino     String?
  /// Anada. Nulo para todo lo que no sea vino: una gaseosa no tiene cosecha, y
  /// un numero de ano pegado a un producto que no lo tiene es informacion falsa.
  vintage      Int?
  /// Bodega. Nulo para lo que no viene de una: una galletita no es de ninguna.
  winery       String?
  /// Cepa. Nulo para lo que no la tiene; para un blend es "Blend".
  varietal     String?
  /// Pesos argentinos enteros. NO centavos (D-15).
  price        Int
  description  String?
  tastingNotes String?
  foodPairing  String?
  imageUrl     String
  stock        Int          @default(0)
  activo       Boolean      @default(true)
  orderItems   OrderItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([category])
  @@index([departamento])
  @@index([grupo])
  @@index([varietal])
  @@index([activo])
  @@index([name])
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  /// Opcional: CE-04 de 004-a permite clientes sin email.
  /// Postgres permite multiples NULL en una columna UNIQUE.
  email       String?  @unique
  phone       String?
  totalOrders Int      @default(0)
  totalSpent  Int      @default(0)
  lastOrderAt DateTime?
  tags        String[] @default([])
  notes       Note[]
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Note {
  id         String   @id @default(cuid())
  text       String
  /// "Admin" hardcoded: no hay auth real todavia (D-05 de 004-a).
  author     String   @default("Admin")
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model Order {
  id              String          @id @default(cuid())
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  total           Int
  status          OrderStatus     @default(pendiente)
  shippingAddress Json
  timeline        OrderTimeline[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  wineId   String
  wine     Wine   @relation(fields: [wineId], references: [id])
  quantity Int
  /// Precio unitario en el momento de la compra (pesos).
  price    Int

  @@index([orderId])
  @@index([wineId])
}

model OrderTimeline {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  author    String      @default("Admin")
  createdAt DateTime    @default(now())

  @@index([orderId])
}